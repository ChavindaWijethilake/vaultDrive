# Database Connection
# Local Development (outside Docker):
DATABASE_URL="postgresql://vaultdrive:vaultdrivepass@localhost:5433/vaultdrive_db?schema=public"
# Docker Production (internal service):
# DATABASE_URL="postgresql://vaultdrive:vaultdrivepass@postgres:5432/vaultdrive_db?schema=public"

# Database Configuration (for Docker)
POSTGRES_USER=vaultdrive
POSTGRES_PASSWORD=vaultdrivepass
POSTGRES_DB=vaultdrive_db

# Admin API Key for Login
API_KEY="secret-key-change-me"

# Optional: Port configuration
PORT=3000
