# Database Configuration
# DATABASE_URL="postgresql://user:password@localhost:5432/vaultdrive?schema=public"
DATABASE_URL="postgresql://vaultdrive:vaultdrivepass@127.0.0.1:5433/vaultdrive_db?schema=public"

# Authentication (Auth.js)
# Generate a secret: npx auth secret
AUTH_SECRET="your-256-bit-secret-here"

# Storage Configuration
# options: local, s3
STORAGE_DRIVER=local

# S3 / MinIO Configuration (Required if STORAGE_DRIVER=s3)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpass
S3_BUCKET=vaultdrive

# Rate Limiting & Security
# (Internal use, keeping API_KEY placeholder for backward compatibility if needed)
API_KEY="vd_local_random_key"
NEXT_PUBLIC_API_KEY="vd_local_random_key"
